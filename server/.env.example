# Port the API listens on
PORT=5000

# Local MongoDB (use 127.0.0.1 rather than localhost on Windows) or a MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/recipe-meal-planner

# Long random string used to sign JWTs - change this!
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Origin of the React app (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development
